{
  "info": {
    "name": "geradorLayout",
    "description": "API REST para gerenciamento e geração de registros posicionais (layouts CNAB, etc.)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Layouts – CRUD",
      "item": [
        {
          "name": "Criar layout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"CNAB_240\",\n  \"descricao\": \"Layout CNAB 240 caracteres\",\n  \"registros\": [\n    {\n      \"nome\": \"HEADER_ARQUIVO\",\n      \"descricao\": \"Header do arquivo\",\n      \"codigo\": \"0\",\n      \"campos\": [\n        {\n          \"nome\": \"codigo_banco\",\n          \"posicaoInicial\": 1,\n          \"posicaoFinal\": 3,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true\n        },\n        {\n          \"nome\": \"lote_servico\",\n          \"posicaoInicial\": 4,\n          \"posicaoFinal\": 7,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true,\n          \"valorDefault\": \"0000\"\n        },\n        {\n          \"nome\": \"tipo_registro\",\n          \"posicaoInicial\": 8,\n          \"posicaoFinal\": 8,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true,\n          \"valorDefault\": \"0\"\n        },\n        {\n          \"nome\": \"nome_empresa\",\n          \"posicaoInicial\": 9,\n          \"posicaoFinal\": 38,\n          \"tipo\": \"ALFANUMERICO\",\n          \"preenchimento\": \"ESPACO_DIREITA\",\n          \"obrigatorio\": true\n        }\n      ]\n    },\n    {\n      \"nome\": \"DETALHE\",\n      \"descricao\": \"Registro de detalhe\",\n      \"codigo\": \"3\",\n      \"campos\": [\n        {\n          \"nome\": \"codigo_banco\",\n          \"posicaoInicial\": 1,\n          \"posicaoFinal\": 3,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true\n        },\n        {\n          \"nome\": \"lote_servico\",\n          \"posicaoInicial\": 4,\n          \"posicaoFinal\": 7,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true\n        },\n        {\n          \"nome\": \"tipo_registro\",\n          \"posicaoInicial\": 8,\n          \"posicaoFinal\": 8,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true,\n          \"valorDefault\": \"3\"\n        },\n        {\n          \"nome\": \"valor\",\n          \"posicaoInicial\": 9,\n          \"posicaoFinal\": 23,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true\n        }\n      ]\n    },\n    {\n      \"nome\": \"TRAILER_ARQUIVO\",\n      \"descricao\": \"Trailer do arquivo\",\n      \"codigo\": \"9\",\n      \"campos\": [\n        {\n          \"nome\": \"codigo_banco\",\n          \"posicaoInicial\": 1,\n          \"posicaoFinal\": 3,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true\n        },\n        {\n          \"nome\": \"lote_servico\",\n          \"posicaoInicial\": 4,\n          \"posicaoFinal\": 7,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true,\n          \"valorDefault\": \"9999\"\n        },\n        {\n          \"nome\": \"tipo_registro\",\n          \"posicaoInicial\": 8,\n          \"posicaoFinal\": 8,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true,\n          \"valorDefault\": \"9\"\n        },\n        {\n          \"nome\": \"qtd_registros\",\n          \"posicaoInicial\": 9,\n          \"posicaoFinal\": 14,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true\n        }\n      ]\n    }\n  ]\n}",
              "options": { "language": "json" }
            },
            "url": {
              "raw": "{{baseUrl}}/layouts",
              "host": ["{{baseUrl}}"],
              "path": ["layouts"]
            }
          },
          "response": []
        },
        {
          "name": "Listar todos os layouts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/layouts",
              "host": ["{{baseUrl}}"],
              "path": ["layouts"]
            }
          },
          "response": []
        },
        {
          "name": "Buscar layout por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/layouts/{{layoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["layouts", "{{layoutId}}"]
            }
          },
          "response": []
