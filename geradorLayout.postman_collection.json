          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/layouts/nome/{{layoutNome}}",
              "host": ["{{baseUrl}}"],
              "path": ["layouts", "nome", "{{layoutNome}}"]
            }
          },
          "response": []
        },
        {
          "name": "Atualizar layout",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"CNAB_240_ATUALIZADO\",\n  \"descricao\": \"Layout CNAB 240 atualizado\",\n  \"registros\": [\n    {\n      \"nome\": \"HEADER_ARQUIVO\",\n      \"descricao\": \"Header do arquivo\",\n      \"codigo\": \"0\",\n      \"campos\": [\n        {\n          \"nome\": \"codigo_banco\",\n          \"posicaoInicial\": 1,\n          \"posicaoFinal\": 3,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true\n        },\n        {\n          \"nome\": \"tipo_registro\",\n          \"posicaoInicial\": 4,\n          \"posicaoFinal\": 4,\n          \"tipo\": \"NUMERICO\",\n          \"preenchimento\": \"ZERO_ESQUERDA\",\n          \"obrigatorio\": true,\n          \"valorDefault\": \"0\"\n        }\n      ]\n    }\n  ]\n}",
              "options": { "language": "json" }
            },
            "url": {
              "raw": "{{baseUrl}}/layouts/{{layoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["layouts", "{{layoutId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Deletar layout",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/layouts/{{layoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["layouts", "{{layoutId}}"]
            }
          },
          "response": []
        }
      ]
